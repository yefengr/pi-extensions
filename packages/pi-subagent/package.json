{
  "name": "@yefengr/pi-subagent",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "default": "./src/service/service.ts"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "default": "./src/layered-settings.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "dist",
    "docs/*.md",
    "docs/architecture",
    "docs/decisions",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "UPSTREAM.md"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "description": "Pi 子代理运行时：进程内子代理、前后台执行、转向、恢复与生命周期事件",
  "license": "MIT",
  "author": "yefengr",
  "contributors": [
    "tintinweb",
    "gotgenes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yefengr/pi-extensions.git",
    "directory": "packages/pi-subagent"
  },
  "homepage": "https://github.com/yefengr/pi-extensions/tree/main/packages/pi-subagent#readme",
  "bugs": {
    "url": "https://github.com/yefengr/pi-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:types": "rollup -c rollup.dts.config.mjs",
    "prepack": "npm run build:types",
    "verify:public-types": "bash scripts/verify-public-types.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "prepublishOnly": "npm run check && npm run verify:public-types && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.19.15",
    "rollup": "4.59.0",
    "rollup-plugin-dts": "6.4.0",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
