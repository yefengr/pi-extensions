{
  "name": "@yefengr/pi-notify",
  "version": "0.3.4",
  "description": "Local terminal notifications for Pi using native OSC protocols",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "license": "MIT",
  "author": "yefengr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yefengr/pi-extensions.git",
    "directory": "packages/pi-notify"
  },
  "homepage": "https://github.com/yefengr/pi-extensions/tree/main/packages/pi-notify#readme",
  "bugs": {
    "url": "https://github.com/yefengr/pi-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "notify",
    "terminal",
    "osc",
    "desktop-notification"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.19.15",
    "typebox": "1.4.2",
    "typescript": "6.0.3"
  }
}
