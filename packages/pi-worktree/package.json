{
  "name": "@yefengr/pi-worktree",
  "version": "0.3.0",
  "description": "Managed Git worktrees with persistent Pi session migration and automatic task continuation",
  "type": "module",
  "language": "zh-CN",
  "license": "MIT",
  "author": "yefengr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yefengr/pi-extensions.git",
    "directory": "packages/pi-worktree"
  },
  "homepage": "https://github.com/yefengr/pi-extensions/tree/main/packages/pi-worktree#readme",
  "bugs": { "url": "https://github.com/yefengr/pi-extensions/issues" },
  "keywords": ["pi-package", "pi-extension", "worktree", "git", "session"],
  "engines": { "node": ">=22.19.0" },
  "publishConfig": { "access": "public" },
  "exports": { ".": "./index.ts" },
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts && node tests/run-smokes.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "files": ["index.ts", "src", "README.md", "LICENSE", "CHANGELOG.md"],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "22.20.5",
    "typebox": "1.4.6",
    "typescript": "6.0.3"
  }
}
