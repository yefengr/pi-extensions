{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "yefengr 维护的 Pi 扩展集合",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:release && npm run test --workspaces --if-present",
    "test:release": "node --test scripts/release.test.mjs",
    "pack:dry-run": "npm pack --dry-run --workspaces"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "6.0.3"
  }
}
